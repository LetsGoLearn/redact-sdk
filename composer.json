{
    "name": "letsgolearn/redact-sdk",
    "description": "Performant PHP/Laravel client for the redactor PII-redaction API (privacy-filter.cpp).",
    "type": "library",
    "keywords": ["pii", "redaction", "privacy", "laravel", "sdk", "ner"],
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.0"
    },
    "autoload": {
        "psr-4": {
            "RedactSdk\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "RedactSdk\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "RedactSdk\\Laravel\\RedactServiceProvider"
            ],
            "aliases": {
                "Redact": "RedactSdk\\Laravel\\Facades\\Redact"
            }
        }
    },
    "suggest": {
        "laravel/framework": "For the service provider, facade, and config integration (^9 || ^10 || ^11 || ^12)."
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
